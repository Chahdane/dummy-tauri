{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DummyTauri",
  "version": "1.0.2",
  "identifier": "com.chahdane.dummytauri",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "DummyTauri",
        "width": 520,
        "height": 650,
        "resizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset:; style-src 'self'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Chahdane/dummy-tauri/releases/latest/download/manifest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgwNUVGNTcwODM4NTVGRDYKUldUV1g0V0RjUFZlZ0NEVHN5YWdBRXZ3bUZYbndjWVo0ZFF5anhsZDg4VzFzZDZKL2hUNFJhWXcK"
    }
  }
}
